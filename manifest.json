{
  "manifest_version": 3,
  "name": "Rules Overlay for D&D 5e",
  "version": "1.0.0",
  "description": "Press a hotkey, type a rule or table-slang, get the D&D 5e SRD answer inline. Bundled, offline, no network calls.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rules Overlay \u2014 open the side panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "downloads"
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open/close the rules overlay"
    },
    "lookup-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Look up the selected text"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "*://chrome.google.com/webstore/*",
        "*://chromewebstore.google.com/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/rules.json",
        "data/aliases.json",
        "data/flows.json",
        "data/sources.json"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
