{
  "name": "rules-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Hotkey-triggered D&D 5e SRD rules lookup overlay for tabletop RPG players.",
  "type": "module",
  "scripts": {
    "build:rules": "tsx scripts/build-rules.ts",
    "build:ext": "node esbuild.config.mjs",
    "build": "npm run build:rules && npm run build:ext",
    "dev": "npm run build:rules && node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-content.mts",
    "icons": "node scripts/rasterise-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.2.0",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
